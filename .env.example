# Exclusive Neon connection for this dealership. Keep verification of TLS certificates enabled.
DATABASE_URL=
# Only required when the database has no administrators yet. At least 12 characters.
ADMIN_BOOTSTRAP_PASSWORD=
PORT=8080
NODE_ENV=production
# Optional: Omnicanal (WhatsApp, Instagram, Facebook, AI agents, CRM) inside this same service,
# published at /omnicanal/ on this domain (omnicanal/PREMIER.md). Setting this secret turns it on.
# It uses the database above, with its tables in their own schema, "omnicanal".
# Signs Omnicanal's sessions; with it this site acts in Omnicanal as each linked salesperson.
# Works like an administrator password: keep it private. Generate it with `openssl rand -hex 32`.
OMNICANAL_SESSION_SECRET=
# Optional: another database for Omnicanal instead of DATABASE_URL.
OMNICANAL_DATABASE_URL=
# Optional: when the background checks run (releasing ended reservations here; campaigns,
# follow-ups, reminders and idle chats in Omnicanal). Default: Monday to Friday (1 = Monday …
# 7 = Sunday), 9:00 to 17:00 New York time, once an hour. Outside it they don't wake the database.
SCHEDULER_DAYS=
SCHEDULER_HOURS=
SCHEDULER_INTERVAL_MINUTES=
# Internal port Omnicanal listens on, loopback only (default 8090).
OMNICANAL_PORT=
# The site's public domain (https://...). Omnicanal uses it plus /omnicanal for what Meta and
# Google fetch on their own. On Railway the generated domain is used when this is empty.
PUBLIC_BASE_URL=
# Optional: Leo, the mascot on the public site, answers typed questions with the OpenAI key below.
# MASCOT_AI=off turns his AI off: he still answers the quick replies, searches the inventory and
# passes the visitor to a salesperson. Model (default gpt-5-mini) and the most AI answers a day
# (default 500, New York time); past it he answers without the AI.
MASCOT_AI=
MASCOT_AI_MODEL=
MASCOT_AI_DAILY_LIMIT=
# Omnicanal's own settings, passed through as they are (see omnicanal/.env.example). Leo uses the
# OpenAI key too, with AI_INTEGRATIONS_OPENAI_BASE_URL or, without it, https://api.openai.com/v1.
AI_INTEGRATIONS_OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: a sign-in on Omnicanal's own form, besides the site's account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Alternative: an Omnicanal instance that runs somewhere else instead of inside this service.
# Its https address, with OMNICANAL_SESSION_SECRET equal to that instance's SESSION_SECRET.
OMNICANAL_URL=
