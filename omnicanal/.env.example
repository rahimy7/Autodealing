# Copy to .env and fill in. The .env file is gitignored.

# Qué cliente es esta instancia. Elige una configuración de
# lib/platform-config/src/clients/ y con ella la marca, la zona horaria y los
# módulos encendidos. `pnpm clients:list` muestra las disponibles.
# Esta copia es la instancia de Premier Line Motors: si no se define, se asume
# premier y se avisa por log.
CLIENT_ID=premier

# Opcional. Retoque puntual de la configuración del cliente sin publicar una
# versión del core: un JSON que se mezcla encima de la del repositorio. Para algo
# permanente, mejor editar el archivo del cliente.
#   CLIENT_CONFIG_JSON={"branding":{"primaryColor":"#E11D48"}}
CLIENT_CONFIG_JSON=

DATABASE_URL=postgresql://USER@localhost:5432/omnicanal

# OpenAI (powers the virtual chatbot agents). Leave the API key empty to
# disable AI auto-replies — the rest of the app still works.
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=

# Signs session tokens. REQUIRED in production (the server refuses to boot
# without it). In development an ephemeral secret is generated on each restart.
# Este archivo es solo para trabajar en el panel por separado (./start.sh). Dentro
# del sitio de Premier no se usa: el sitio le pasa OMNICANAL_SESSION_SECRET con
# este nombre. Si el sitio local apunta a esta instancia (OMNICANAL_URL), los dos
# valores deben coincidir.
SESSION_SECRET=

# Administrator login. REQUIRED in production. In development it falls back to
# admin@decolor.com / demo. Human agents log in with their own email and the
# password the administrator sets for them in the Agentes page.
ADMIN_EMAIL=admin@premierlinemotors.com
ADMIN_PASSWORD=

# Optional. Log verbosity: trace | debug | info | warn | error | fatal.
LOG_LEVEL=info

# Optional. How long a chat may stay quiet before the conversation is considered
# over (default 360 = 6 h). The next message from that customer then opens a NEW
# conversation: the agent starts fresh and the earlier thread is kept only as
# background reference.
CONVERSATION_IDLE_MINUTES=360

# Optional. Con cuánta antelación se le recuerda la cita al cliente, en horas
# (por defecto 24). Ponlo en 0 para apagar los recordatorios de esta instancia.
# Solo aplica con el módulo `appointments` encendido.
APPOINTMENT_REMINDER_HOURS=24

# Optional. Timezone used for every timestamp the AI reads, so it reasons about
# "hoy" and the hour the way the business does. Sin definir, se usa la del
# cliente (locale.timezone en su configuración).
APP_TIMEZONE=

# Optional. Tasa de cambio del día (USD y EUR frente al peso) desde la API
# BPDConsultaTasa del Banco Popular. Clave y Secreto salen del portal de APIs del
# banco. Sin ClientId, ClientSecret, TokenUrl y BaseUrl no se consulta nada; con
# ellas se consulta sola cada día a las 07:00 hora del negocio (y al responder un
# agente virtual si la guardada no es de hoy), los agentes dan los montos en pesos
# con ella y se ve en Configuración → Tasa de cambio. Los nombres son los mismos
# de masqsalud.
PopularApi__ClientId=
PopularApi__ClientSecret=
PopularApi__TokenUrl=https://api.us-east-a.apiconnect.ibmappdomain.cloud/apiportalpopular/bpdsandbox/bpd/Authentication/oauth2/token
PopularApi__BaseUrl=https://api.us-east-a.apiconnect.ibmappdomain.cloud/apiportalpopular/bpdsandbox
PopularApi__ConsultaTasaPath=/consultatasa/consultaTasa
PopularApi__Scope=scope_1

# ── Despliegue ───────────────────────────────────────────────────────────────
# En producción Omnicanal no es un servicio aparte: corre dentro del servicio del
# sitio de Premier y se publica en /omnicanal/ de su dominio. Sus variables van en
# ese servicio (ver PREMIER.md); el sitio le pasa DATABASE_URL (la misma del
# sitio: las tablas de Omnicanal van en el esquema "omnicanal"), SESSION_SECRET,
# PORT y PUBLIC_BASE_URL con los nombres que este servidor espera.
#
# Meta/WhatsApp credentials are not env vars: the administrator saves them from
# the Configuración page and they are stored in the database.
